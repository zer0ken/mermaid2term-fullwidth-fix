{
  "name": "mermaid2term",
  "version": "0.1.0",
  "description": "Render Mermaid diagrams as ASCII/Unicode art in the terminal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "mermaid2term": "./bin/mermaid2term.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mermaid",
    "ascii",
    "unicode",
    "diagram",
    "flowchart",
    "sequence",
    "terminal",
    "cli",
    "text",
    "box-drawing"
  ],
  "author": "watzon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/watzon/mermaid2term"
  },
  "homepage": "https://github.com/watzon/mermaid2term#readme",
  "bugs": {
    "url": "https://github.com/watzon/mermaid2term/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
